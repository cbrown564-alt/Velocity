{
  "name": "brand-tracker-deck-export",
  "description": "Load the brand tracker Wave 4 example, confirm the funnel-relevant crosstab, and export an editable PPTX with a download artifact and success-state screenshot.",
  "startUrl": "/",
  "timeoutMs": 120000,
  "settleMs": 250,
  "artifactsDir": "demo/artifacts/brand-tracker-deck-export/latest",
  "engineReference": {
    "script": "scripts/brand-tracker-demo.ts",
    "command": "npm run demo:brand-tracker",
    "notes": "Builds the canonical 18-slide tracker deck per story template 08 3 and exports the golden PPTX tests/fixtures/export/brandtracker-report.pptx."
  },
  "preconditions": [
    "Dev server reachable via Playwright baseURL (default: http://127.0.0.1:4173).",
    "Fixture file exists at public/examples/brandtracker_w4.sav.",
    "Browser context starts with no modal/dialog blockers."
  ],
  "sensitiveSelectors": ["[data-testid='user-email']", "[data-testid='account-id']"],
  "steps": [
    {
      "id": "open-workspace",
      "goal": "Load root workspace",
      "action": "goto",
      "target": "/",
      "assert": {
        "type": "attached",
        "selector": "[data-testid='dataset-upload-input']"
      },
      "capture": true
    },
    {
      "id": "upload-tracker",
      "goal": "Attach the brand tracker Wave 4 file",
      "action": "upload",
      "selector": "[data-testid='dataset-upload-input']",
      "value": "public/examples/brandtracker_w4.sav",
      "assert": {
        "type": "visibleAny",
        "selectors": ["text=Survey Questions", "text=Metadata Loaded"]
      },
      "capture": true,
      "settleMs": 500
    },
    {
      "id": "load-full-data-if-needed",
      "goal": "Resolve metadata-only ingestion branch",
      "action": "clickIfVisible",
      "selector": "button:has-text('Load Full Data')",
      "assert": {
        "type": "visible",
        "selector": "text=Survey Questions"
      },
      "capture": false,
      "settleMs": 500
    },
    {
      "id": "verify-funnel-crosstab",
      "goal": "Confirm the funnel-relevant first crosstab renders before export",
      "action": "waitForTimeout",
      "value": "1500",
      "assert": {
        "type": "visible",
        "selector": "table"
      },
      "capture": true,
      "settleMs": 500
    },
    {
      "id": "open-export-modal",
      "goal": "Open export modal from analysis canvas",
      "action": "clickRole",
      "role": "button",
      "namePattern": "^Export$",
      "nameFlags": "i",
      "assert": {
        "type": "stable",
        "selector": "[data-testid='export-modal']"
      },
      "capture": true,
      "settleMs": 400
    },
    {
      "id": "export-pptx",
      "goal": "Download PPTX and confirm export success state",
      "action": "clickAndWaitForDownload",
      "selector": "[data-testid='export-modal-submit']",
      "expectedExtension": ".pptx",
      "downloadFilename": "brandtracker-export.pptx",
      "assert": {
        "type": "visible",
        "selector": "[data-testid='export-modal-success']"
      },
      "capture": true,
      "captureSelector": "[data-testid='export-modal-success']",
      "settleMs": 400
    }
  ],
  "successMetric": {
    "type": "stepCount",
    "minimumCompleted": 6
  }
}
