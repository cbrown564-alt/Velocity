  "findings": [
    {
      "model_finding_id": "F01",
      "proposition": "Assignment increased awareness change among observed pairs: +27.93 percentage points in the invitation arm versus +14.33 in control, an additional 13.59 points (95% CI 9.52 to 17.66; Holm p=1.81e-10).",
      "evidence_refs": [
        "analysis_claims/A01_PRIMARY/values/awareness"
      ],
      "importance": "primary",
      "claim_strength": "Supported by the prespecified multiplicity-adjusted assignment test.",
      "qualification": "Control/invitation paired N=1,016/960. This is an observed-pair assignment estimate; incomplete follow-up prevents automatic interpretation as a full-cohort or population effect.",
      "topic_cluster": "campaign_effectiveness"
    },
    {
      "model_finding_id": "F02",
      "proposition": "Awareness gains did not establish additional consideration or reported use. Consideration rose 8.36 points in each arm; its assignment contrast was -0.01 points (95% CI -3.44 to 3.42; Holm p=.996). Usage rose 2.61 points under invitation versus 3.59 in control; contrast -0.98 points (95% CI -2.70 to 0.74; Holm p=.528).",
      "evidence_refs": [
        "analysis_claims/A01_PRIMARY/values/consideration_top2",
        "analysis_claims/A01_PRIMARY/values/reported_usage"
      ],
      "importance": "primary",
      "claim_strength": "No statistically established incremental change in either downstream endpoint.",
      "qualification": "Control/invitation paired N=1,015/966 for consideration and 1,007/969 for usage. Non-significance does not establish zero effect or equivalence; control growth has no uniquely identified mechanism.",
      "topic_cluster": "campaign_effectiveness"
    },
    {
      "model_finding_id": "F03",
      "proposition": "Selective follow-up materially limits generalisation. Weighted return was 72.38% under invitation versus 75.98% in control. Returners already had higher consideration (30.13% versus 21.99%) and usage (5.80% versus 3.93%) than nonreturners, and were less often households with children (32.43% versus 42.31%).",
      "evidence_refs": [
        "analysis_claims/A02_WAVES_MISSINGNESS/values",
        "analysis_claims/A03_ATTRITION_SELECTION/values"
      ],
      "importance": "primary",
      "claim_strength": "Descriptive evidence of differential retention and baseline selection.",
      "qualification": "There were 711 nonreturners, plus endpoint-specific numeric missingness. Returners also reported greater digital confidence and lower budget pressure. These patterns do not identify the magnitude or direction of missing-outcome bias; baseline weights do not repair it.",
      "topic_cluster": "evidence_limits"
    },
    {
      "model_finding_id": "F04",
      "proposition": "Children households remain a plausible needs-based audience, but superior campaign responsiveness is unestablished. Their consideration contrast was +2.95 points and usage contrast +0.91; corresponding children-minus-no-children interactions were +4.27 (95% CI -2.95 to 11.48; Holm p=.472) and +2.81 (-0.98 to 6.59; p=.438). Awareness interaction was -5.07 (-13.46 to 3.32; p=.472).",
      "evidence_refs": [
        "analysis_claims/A04_CHILDREN/values"
      ],
      "importance": "secondary",
      "claim_strength": "Prespecified interactions do not establish heterogeneity; audience need is descriptive.",
      "qualification": "Each interaction cell has N\u2265345. High/extreme baseline meal stress was 56.48% with children versus 36.56% without, but need is distinct from targeting effectiveness. The exploratory older-online-confident subgroup has only 19\u201322 pairs per arm and is suppressed.",
      "topic_cluster": "audience_priority"
    },
    {
      "model_finding_id": "F05",
      "proposition": "Invitations increased logged reach descriptively, but receipt and recall cannot substitute for assignment. Receipt was 70.16% under invitation versus 24.55% in control. Recipients' 19.12-point follow-up consideration advantage was already 19.15 points at baseline; recallers' 37.24-point follow-up advantage also began with a 32.35-point baseline gap.",
      "evidence_refs": [
        "analysis_claims/A05_REACH_SELECTION/values"
      ],
      "importance": "secondary",
      "claim_strength": "Descriptive reach and selection evidence, not causal receipt effects.",
      "qualification": "Receipt includes all 2,800 enrollees; consideration receipt comparisons use 1,981 pairs, recall comparisons 1,884. Among valid recall cases, 34.18% of logged recipients did not recall, while 15.73% without logged receipt did recall. Logs measure receipt, not attention.",
      "topic_cluster": "exposure_interpretation"
    },
    {
      "model_finding_id": "F06",
      "proposition": "Selected recallers and users report favourable experiences, providing hypotheses for a follow-up test rather than proof of conversion. Agreement was 76.74% for clarity, 70.52% for relevance and 75.90% for believability; 87.74% of valid current-user respondents were satisfied.",
      "evidence_refs": [
        "analysis_claims/A06_DIAGNOSTICS_EXPERIENCE/values"
      ],
      "importance": "secondary",
      "claim_strength": "Descriptive evidence within routed, selected groups.",
      "qualification": "Message valid N=852\u2013862; satisfaction N=202. Rating correlations of .50\u2013.54 describe shared impressions, not causal drivers. Numerical rating differences do not establish superiority. User satisfaction cannot be attributed to assignment.",
      "topic_cluster": "followup_learning"
    },
    {
      "model_finding_id": "F07",
      "proposition": "The evidence supports a further controlled test with an explicit awareness objective and a separately powered test of consideration and use, rather than expansion justified by proven downstream returns. Improve outcome retention and prespecify any children-household interaction; test conversion changes as hypotheses.",
      "evidence_refs": [
        "analysis_claims/A01_PRIMARY/values",
        "analysis_claims/A02_WAVES_MISSINGNESS/values",
        "analysis_claims/A04_CHILDREN/values",
        "analysis_claims/A06_DIAGNOSTICS_EXPERIENCE/values"
      ],
      "importance": "primary",
      "claim_strength": "Research recommendation derived from the measured outcomes and limitations.",
      "qualification": "No cost, revenue, purchase or administrative active-user outcomes were supplied. ROI, actual sales, full-population effects and an optimal targeting or channel strategy remain unestablished.",
      "topic_cluster": "decision"
    }
